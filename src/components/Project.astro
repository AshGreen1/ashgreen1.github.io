---
const { title, desc, tech, date, link, imgSrc, imagePosition = 'top', background = 'transparent', borderRadius = '0' } = Astro.props;
---

<div class="single-item">
  <div class={`item-main-section layout-${imagePosition}`}>
    {imgSrc && (
      <div class="item-image-container">
        <img src={imgSrc} alt={title} loading="lazy" class="item-image" style={`background-color: ${background}; border-radius: ${borderRadius};`} />
      </div>
    )}
    
    <div class="item-header">
      <h3 class="item-title">{title}</h3>
      {link && (
        <div class="item-link-wrapper">
          <a href={link} target="_blank" rel="noopener noreferrer" class="item-link">
            {link}
          </a>
        </div>
      )}
      {date && <span class="item-date">{date}</span>}
    </div>
  </div>

  {/* Solo muestra la descripción si existe y tiene elementos */}
  {desc && desc.length > 0 && (
    <div class="project-desc project-desc-list w-richtext">
      <ul role="list">
        {desc.map((item: any) => <li>{item}</li>)}
      </ul>
    </div>
  )}
  
  {/* Solo muestra las tecnologías si existen y tienen elementos */}
  {tech && tech.length > 0 && (
    <>
      <div class="mini-label-white" style="margin-top: 1.5rem;">Technologies &amp; tools</div>
      <div class="chips-container">
        {tech.map((techItem: any) => <div class="single-chip">{techItem}</div>)}
      </div>
    </>
  )}
</div>

<style>
  .single-item {
    margin-bottom: 2rem;
  }

  .layout-top {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .layout-side {
    display: flex;
    flex-direction: row;
    align-items: center; /* Centra el contenido verticalmente */
    gap: 1.5rem;
  }

  .layout-side .item-image-container {
    flex-shrink: 0;
    max-width: 80px; 
  }

  .item-header {
    margin: 0; /* Quité el margen extra porque el gap de layout-side ya separa la imagen del texto */
    flex: 1; /* Le dice al texto que ocupe el espacio sobrante */
    min-width: 0; /* CRUCIAL: Permite que el contenedor se encoja y el texto haga salto de línea */
  }

  .item-title {
    margin: 0; 
    word-wrap: break-word; /* Fuerza el salto de línea en palabras o IDs muy largos */
    overflow-wrap: break-word;
    line-height: 1.3; /* Mejora la lectura en varias líneas */
  }
  
  .project-desc {
    margin-top: 1rem;
  }

  /* Opcional: Si en pantallas MUY pequeñas (móviles) quieres que la imagen pase arriba para que el texto no quede tan apretado */
  @media (max-width: 480px) {
    .layout-side {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>