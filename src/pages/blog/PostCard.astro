---
const { post } = Astro.props;

// Handle case where PostCard is rendered as standalone page (no props)
if (!post) {
  // Return a minimal page for standalone rendering
  return Astro.redirect('/blog/blog');
}

// Extract slug from file path - post is a Module object from Astro.glob
const slug = post.file 
  ? post.file.split('/').pop().replace('.md', '')
  : post.frontmatter?.title ? post.frontmatter.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
  : 'unknown';
---

<article class="post-card" data-post-slug={slug} onclick={`loadPost('${slug}')`} style="cursor: pointer;">
  <div class="post-meta">
    <time datetime={post.frontmatter.date}>
      {new Date(post.frontmatter.date).toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })}
    </time>
  </div>
  <h2 class="post-title">{post.frontmatter.title}</h2>
  <p class="post-description">{post.frontmatter.description}</p>
  <div class="post-tags">
    {post.frontmatter.tags.map((tag: any) => (
      <span class="tag">{tag}</span>
    ))}
  </div>
</article>
