---
import Header from "@components/Header.astro";
import Sidebar from "@components/Sidebar.astro";
import ProjectCard from "@components/ProjectCard.astro";
import SocialCard from "@components/SocialCard.astro";
import ExperienceTimeline from "@components/ExperienceTimeline.astro";
import '@styles/styles.css'

const history = [
  {
    date: "2024 - Current",
    title: "Evertec",
    role: "Penetration Testing Sr Specialist",
    imgSrc: "https://evertecinc.com/wp-content/uploads/2025/05/Content.svg",
    link: "https://evertecinc.com/"
  },
  {
    date: "2023 - 2024",
    title: "FluidAttacks",
    role: "Security Tester",
    imgSrc: "https://framerusercontent.com/images/Hm3XiqIsbZAvDR2N3ul8PKlUXi8.png?scale-down-to=250&width=100&height=100",
    link: "https://fluidattacks.com/"
  },
  {
    date: "2021 - Current",
    title: "HackerOne & Bugcrowd",
    role: "Vulnerability Researcher",
    imgSrc: "https://www.hackerone.com/themes/custom/hackerone/logo.svg",
    link: "https://hackerone.com/"
  }
];
---

<!DOCTYPE html>
<html>
  <link rel="stylesheet" href="/assets/timeline-style.css">
  <Header title="Renzo Machado" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              
              <div class="hero-container">
                <img src="https://ashgreen1.dev/assets/me-full.jpg" alt="Profile" class="profile-image" />
                <div class="hero-text">
                  <h1>Hi, I'm Renzo Machado.</h1>
                  <h2 style="margin-top: 0.5rem; color:#f3f3f3; font-size: 2.2rem;">I break and fix things for fun and bounties.</h2>
                </div>
              </div>
              <!-- Contenedor de Redes Sociales -->
              <div class="social-links-container">
                <SocialCard 
                  platform="LinkedIn" 
                  href="https://www.linkedin.com/in/renzo-neomar-machado-50881a235/?locale=en_US" 
                  iconSrc="/assets/socials/linkedin.svg" 
                />
                <SocialCard 
                  platform="HackerOne" 
                  href="https://hackerone.com/ashgreen_1" 
                  iconSrc="/assets/socials/hackerone.svg" 
                />
                <SocialCard 
                  platform="HackTheBox" 
                  href="https://app.hackthebox.com/public/users/864704" 
                  iconSrc="/assets/socials/hackthebox.svg" 
                />
              </div>

              <br />
              <p class="lead">
                Experienced penetration tester and backend developer. A proactive team member dedicated to continuous learning, problem-solving, and aiding teammates in achieving quicker outcomes.
              </p>
            </div>
          </main>

          <section class="experience-history">
            <h3 style="text-align: center; margin-bottom: 3rem; color:#f3f3f3">Experience Timeline</h3>
            <ExperienceTimeline experiences={history} />
          </section>

          <h3 style="text-align: center; margin-bottom: 3rem; color:#f3f3f3">Skills</h3>
          
          <div class="projects-section">
            <ProjectCard 
              href="/experiences"
              imgSrc="https://ashgreen1.dev/assets/sidebar/bug.svg"
              title="Penetration Testing"
              technologies={[
                "OWASP", "Burp Suite", "Nmap", "Metasploit", "SQLMap", 
                "John the Ripper", "Hydra", "Wireshark", "Curl", 
                "Nessus", "OpenVAS", "Nikto", "Dirb", "Dirbuster"
              ]}
            />
          </div>

          <a href="mailto:renzo.machado@gmail.com" class="button w-button">Contact</a>
          
        </div>
      </nav>
    </div>
    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>