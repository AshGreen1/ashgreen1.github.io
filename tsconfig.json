{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@styles/*": ["src/styles/*"],
      "@assets/*": ["public/assets/*"],
      "@scripts/*": ["src/scripts/*"],
      "@blog/*": ["public/blog/*"],
      "@pages/*": ["src/pages/*"]
    }
  }
}
